graph TB
    subgraph "CLI Layer"
        train["<b>fraude train</b><br/>entrena y registra en MLflow"]
        promote["<b>fraude promote</b><br/>promueve el ganador a Production"]
        serve["<b>fraude serve</b><br/>levanta uvicorn"]
    end

    subgraph "Serving Layer (deteccion_fraude/api/)"
        api["<b>FastAPI app</b><br/>GET / &middot; GET /health &middot; POST /predict"]
        schemas["<b>schemas.py</b><br/>Pydantic v2: Transaction,<br/>PredictionRequest/Response"]
        loader["<b>model_loader.py</b><br/>resuelve version + flavor"]
    end

    subgraph "Inference Bridge (deteccion_fraude/serving.py)"
        artifacts["<b>ServingArtifacts</b><br/>scalers + noise_mask +<br/>thresholds + AmountStats"]
        scoring["<b>ScoringModel</b><br/>score() uniforme por flavor"]
    end

    subgraph "Core Layer (deteccion_fraude/)"
        config["<b>ExperimentConfig</b><br/>@dataclass(frozen=True)<br/>11 params + 4 properties"]
        dataset["<b>FraudDataset</b><br/>static: load, clean, split"]
        features["<b>FraudFeatureEngineer</b><br/>transform: 22 engineered features"]
        preprocessor["<b>FraudPreprocessor</b><br/>scalers + SMOTE + class weights"]
        evaluator["<b>FraudModelEvaluator</b><br/>threshold optimization + metrics"]
        visualizer["<b>FraudVisualizer</b><br/>6 plotting methods"]
        tracking["<b>MLflowFraudTrainer</b><br/>log, register, promote, compare"]
    end

    subgraph "Modeling Layer (deteccion_fraude/modeling/)"
        pipeline["<b>FraudDetectionPipeline</b><br/>&laquo;facade&raquo;<br/>orchestrates everything"]
        selector["<b>TabNetFeatureSelector</b><br/>noise filter + top-N selection"]
        lstm["<b>LSTMDetector</b><br/>Bidirectional LSTM + FocalLoss"]
        tabnet["<b>TabNetDetector</b><br/>TabNet classifier"]
    end

    subgraph "Data Objects"
        splits["<b>DatasetSplits</b><br/>df_train, df_val, df_test"]
        prepared["<b>PreparedData</b><br/>15 arrays + scalers + weights"]
    end

    subgraph "External ML Frameworks"
        sklearn["scikit-learn<br/>RobustScaler, StandardScaler"]
        imblearn["imbalanced-learn<br/>SMOTE"]
        tensorflow["TensorFlow/Keras<br/>BiLSTM, FocalLoss"]
        pytorch["PyTorch<br/>TabNet, CUDA"]
    end

    subgraph "DVC / Storage"
        dvc["DVC<br/>data/raw/creditcard.csv"]
        gdrive["Google Drive<br/>remote: gdrive://..."]
    end

    subgraph "MLflow"
        registry["Model Registry<br/>fraud_tabnet / fraud_lstm<br/>stage: Production"]
        store["Backend store<br/>sqlite:///mlflow.db"]
        pkl[("models/serving_artifacts.pkl")]
    end

    train --> config
    train --> dataset
    train --> preprocessor
    train --> pipeline
    promote --> tracking

    dataset --> splits
    preprocessor --> features
    preprocessor --> prepared

    pipeline --> selector
    pipeline --> lstm
    pipeline --> tabnet
    pipeline --> evaluator
    pipeline --> tracking
    pipeline -->|save_serving_artifacts| pkl

    selector --> pytorch
    selector --> prepared
    lstm --> tensorflow
    lstm --> prepared
    tabnet --> pytorch
    tabnet --> prepared
    preprocessor --> sklearn
    preprocessor --> imblearn
    evaluator --> sklearn

    tracking --> store
    tracking --> registry

    serve --> api
    api --> schemas
    api --> loader
    api --> artifacts
    api --> scoring
    loader -->|models:/name/Production| registry
    loader -->|unpickle| pkl
    artifacts --> features
    artifacts --> sklearn

    config -.- dvc
    dvc --- gdrive

    style pipeline fill:#e1f5fe,stroke:#0288d1,stroke-width:2px
    style config fill:#fff3e0,stroke:#f57c00,stroke-width:2px
    style train fill:#e8f5e9,stroke:#388e3c,stroke-width:2px
    style serve fill:#e8f5e9,stroke:#388e3c,stroke-width:2px
    style promote fill:#e8f5e9,stroke:#388e3c,stroke-width:2px
    style api fill:#e0f7fa,stroke:#00838f,stroke-width:2px
    style artifacts fill:#fff8e1,stroke:#ff8f00,stroke-width:2px
    style lstm fill:#fce4ec,stroke:#c62828
    style tabnet fill:#f3e5f5,stroke:#7b1fa2
