graph LR
    subgraph "Step 1: Load and Clean"
        A["creditcard.csv<br/>284K rows x 50 cols"] -->|"FraudDataset.load"| B["DataFrame<br/>nulos + dup eliminados"]
    end

    subgraph "Step 2: Split"
        B -->|"FraudDataset.split"| C["DatasetSplits<br/>train 70% | val 15% | test 15%<br/>sorted by Time"]
    end

    subgraph "Step 3: Feature Engineering"
        C -->|"FraudFeatureEngineer.transform"| D["DataFrame<br/>+22 engineered features<br/>50 -> 50 cols"]
    end

    subgraph "Step 4: Scaling"
        D -->|"RobustScaler + StandardScaler<br/>fit solo en train"| E["Scaled DataFrame"]
        E --> F["PreparedData<br/>X_train: 198K*50<br/>X_validation: 42K*50<br/>X_test: 42K*50<br/>+ AmountStats"]
    end

    subgraph "Step 5: Feature Selection"
        F -->|"TabNetFeatureSelector"| G["PreparedData filtered<br/>X_train: N*50 to N*50<br/>X_train_lstm: N*30<br/>selected: top-N features"]
    end

    subgraph "Step 6: Train Models (SMOTE ratio=0.30 solo en train)"
        G -->|"LSTMDetector.fit"| H["LSTM Model<br/>BiLSTM 64-32 + focal loss<br/>sequences of 5"]
        G -->|"TabNetDetector.fit"| I["TabNet Model<br/>n_d=32, n_a=32<br/>n_steps=5, gamma=1.3"]
    end

    subgraph "Step 7: Evaluate"
        H -->|"predict_test"| J["LSTM scores"]
        I -->|"predict_test"| K["TabNet scores"]
        J -->|"FraudModelEvaluator"| L["Results<br/>F1, ROI, Precision, Recall<br/>optimal threshold"]
        K -->|"FraudModelEvaluator"| L
    end

    subgraph "Step 8: Save and Register"
        H -->|"save"| M["models/lstm_fraud_detector.keras"]
        I -->|"save"| M2["models/tabnet_fraud_detector.zip"]
        L -->|"save_serving_artifacts"| M3["models/serving_artifacts.pkl<br/>scalers + noise_mask + thresholds<br/>+ selected_features + AmountStats"]
        L -->|"log_to_mlflow"| M4["mlflow.db<br/>params, metrics, tags,<br/>modelos y figuras"]
    end

    subgraph "Step 9: Promote and Serve"
        M4 -->|"fraude promote"| N["Model Registry<br/>fraud_tabnet stage=Production"]
        N --> O["FastAPI<br/>POST /predict"]
        M3 --> O
        P["Transaccion cruda<br/>Time, V1-V28, Amount"] --> O
        O --> Q["Veredicto<br/>probabilidad, umbral por ROI,<br/>high_risk_flag"]
    end

