classDiagram
    direction TB

    class ExperimentConfig {
        <<dataclass, frozen>>
        +Path data_file
        +Path models_dir
        +Path figures_dir
        +int random_state
        +float validation_size
        +float test_size
        +int sequence_length
        +float smote_ratio
        +float false_negative_cost
        +float false_positive_cost
        +int min_lstm_features
        +list~str~ pca_columns$
        +list~str~ robust_columns$
        +list~str~ standard_columns$
        +list~str~ feature_columns$
        +create_output_directories() None
    }

    class DatasetSplits {
        <<dataclass>>
        +DataFrame df_train
        +DataFrame df_val
        +DataFrame df_test
    }

    class PreparedData {
        <<dataclass>>
        +ndarray X_train
        +ndarray X_validation
        +ndarray X_test
        +ndarray X_train_lstm
        +ndarray X_validation_lstm
        +ndarray X_test_lstm
        +ndarray y_train
        +ndarray y_validation
        +ndarray y_test
        +list~str~ feature_names
        +dict class_weights
        +object robust_scaler
        +object standard_scaler
        +AmountStats amount_stats
        +apply_feature_selection(noise_mask, selected_features) None
    }

    class AmountStats {
        <<dataclass, frozen>>
        +float mean
        +float std
        +list~float~ log_bin_edges
        +from_dataframe(dataframe)$ AmountStats
    }

    class FraudDataset {
        <<utility>>
        +REQUIRED_COLUMNS$ set
        +load(path)$ DataFrame
        +clean(dataframe)$ DataFrame
        +split(df, config)$ DatasetSplits
    }

    class FraudFeatureEngineer {
        <<service>>
        +ExperimentConfig config
        +transform(dataframe, amount_stats) DataFrame
    }

    class FraudPreprocessor {
        <<service>>
        +ExperimentConfig config
        +FraudFeatureEngineer engineer
        +fit_transform(splits) PreparedData
    }

    class FraudModelEvaluator {
        <<service>>
        +ExperimentConfig config
        +find_best_threshold(y_true, scores) tuple
        +evaluate(y_true, scores, model_name, threshold) dict
        +theoretical_best_f1(y_true, scores)$ float
    }

    class FraudVisualizer {
        <<view>>
        +ExperimentConfig config
        +summarize(dataframe)$ dict
        +plot_overview(dataframe) None
        +plot_feature_importance(selector)$ None
        +plot_model_comparison(y_true, scores, results)$ None
        +plot_confusion_matrix(cm, model_name) None
        +plot_results_summary(results) None
    }

    class TabNetFeatureSelector {
        <<service>>
        +ExperimentConfig config
        +str device
        +TabNetClassifier model
        +float training_time
        +ndarray noise_mask
        +Series feature_importance
        +ndarray cumulative_importance
        +int features_for_95
        +int n_selected
        +list~str~ selected_features
        +_build_model() TabNetClassifier
        +fit_transform(data) PreparedData
    }

    class focal_loss_fn {
        <<closure>>
        +float gamma
        +float alpha
        +focal_loss(y_true, y_pred) Tensor
    }

    class LSTMDetector {
        <<model>>
        +ExperimentConfig config
        +ndarray validation_X
        +ndarray validation_y
        +ndarray test_X
        +ndarray test_y
        +Model model
        +History history
        +float training_time
        +create_sequences(data, labels, length)$ tuple
        +_build(n_features) Model
        +fit(data) LSTMDetector
        +predict_validation() ndarray
        +predict_test() ndarray
        +save(path) None
    }

    class TabNetDetector {
        <<model>>
        +ExperimentConfig config
        +str device
        +TabNetClassifier model
        +float training_time
        +_build() TabNetClassifier
        +fit(data) TabNetDetector
        +predict_validation(data) ndarray
        +predict_test(data) ndarray
        +save(path) None
    }

    class FraudDetectionPipeline {
        <<facade>>
        +ExperimentConfig config
        +PreparedData data
        +str device
        +TabNetFeatureSelector selector
        +LSTMDetector lstm
        +TabNetDetector tabnet
        +FraudModelEvaluator evaluator
        +MLflowFraudTrainer trainer
        +dict results
        +dict validation_scores
        +dict test_scores
        +ndarray y_test_aligned
        +select_features() FraudDetectionPipeline
        +train() FraudDetectionPipeline
        +evaluate() dict
        +save_serving_artifacts() Path
        +log_to_mlflow(run_name) str
    }

    class MLflowFraudTrainer {
        <<service>>
        +ExperimentConfig config
        +log_training(lstm, tabnet, data, results, run_name) str
        +evaluate_with_mlflow(model, X_test, y_test, name) dict
        +promote_best_model(run_id, metric) str
        +compare_runs(experiment) DataFrame
    }

    class ServingArtifacts {
        <<dataclass>>
        +object robust_scaler
        +object standard_scaler
        +AmountStats amount_stats
        +list~str~ robust_columns
        +list~str~ standard_columns
        +list~str~ feature_columns
        +ndarray noise_mask
        +list~str~ feature_names
        +list~str~ selected_features
        +dict thresholds
        +int sequence_length
        +from_training(config, data, selector, results)$ ServingArtifacts
        +save(models_dir) Path
        +load(models_dir)$ ServingArtifacts
        +threshold_for(kind, default) float
        +build_matrix(raw) DataFrame
        +lstm_windows(matrix) ndarray
    }

    class ScoringModel {
        <<dataclass>>
        +str kind
        +object model
        +score(features) ndarray
    }

    class Transaction {
        <<pydantic BaseModel>>
        +float time
        +float v1
        +float v28
        +float amount
    }

    class PredictionResponse {
        <<pydantic BaseModel>>
        +ModelMetadata model_metadata
        +float decision_threshold
        +int total_predictions
        +int scored_from_index
        +list~TransactionPrediction~ results
        +str message
    }

    class FastAPI_app {
        <<api>>
        +lifespan() None
        +read_root() ServiceStatus
        +health(response) ServiceStatus
        +predict(payload) PredictionResponse
    }

    class model_loader {
        <<module>>
        +str MODEL_NAME
        +load_model() ScoringModel
        +get_model_metadata() dict
        +load_artifacts() ServingArtifacts
    }

    class tf_KerasLoss {
        <<external>>
    }

    FraudDetectionPipeline *-- TabNetFeatureSelector : selector
    FraudDetectionPipeline *-- LSTMDetector : lstm
    FraudDetectionPipeline *-- TabNetDetector : tabnet
    FraudDetectionPipeline *-- FraudModelEvaluator : evaluator
    FraudDetectionPipeline *-- MLflowFraudTrainer : trainer
    FraudPreprocessor *-- FraudFeatureEngineer : engineer

    focal_loss_fn ..> tf_KerasLoss : passed as loss

    FraudDetectionPipeline --> ExperimentConfig : config
    FraudDetectionPipeline --> PreparedData : data

    LSTMDetector ..> focal_loss_fn : uses
    LSTMDetector ..> PreparedData : consumes
    TabNetDetector ..> PreparedData : consumes
    TabNetFeatureSelector ..> PreparedData : mutates
    FraudPreprocessor ..> DatasetSplits : consumes
    FraudPreprocessor ..> PreparedData : produces
    FraudPreprocessor ..> AmountStats : records
    FraudDataset ..> DatasetSplits : produces
    FraudDataset ..> ExperimentConfig : param

    FraudVisualizer --> ExperimentConfig : config
    FraudVisualizer ..> TabNetFeatureSelector : duck-typed

    PreparedData *-- AmountStats : amount_stats
    FraudFeatureEngineer ..> AmountStats : optional param

    FraudDetectionPipeline ..> ServingArtifacts : produces
    ServingArtifacts *-- AmountStats : amount_stats
    ServingArtifacts ..> FraudFeatureEngineer : reapplies

    FastAPI_app ..> model_loader : bootstraps
    FastAPI_app ..> ServingArtifacts : build_matrix
    FastAPI_app ..> ScoringModel : score
    FastAPI_app ..> Transaction : validates
    FastAPI_app ..> PredictionResponse : returns
    model_loader ..> ScoringModel : wraps flavor
    model_loader ..> ServingArtifacts : loads pickle

    note for Transaction "v1..v28 son 28 campos float. Alias = columna del dataset (V1..V28); populate_by_name acepta ambas formas."
    note for ServingArtifacts "El Registry guarda el modelo pero no el preprocesamiento que lo alimenta."
